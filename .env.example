# Optional CoinGecko Demo/Pro key. Public access is attempted when empty.
COINGECKO_API_KEY=
COINGECKO_PLAN=demo

# Report settings
TOP_N=5
BASKET_BUDGET_USD=100
UNIVERSE_SIZE=120
MIN_MARKET_CAP_USD=50000000
MIN_VOLUME_USD=5000000
EXCLUDE_MEME_COINS=true
REPORT_TIMEZONE=Europe/Istanbul

# SMTP settings (example: Gmail uses smtp.gmail.com:587 and an app password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
SMTP_TO=
SMTP_STARTTLS=true
